# Copy to .env next to docker-compose.yml, fill in, then: chmod 600 .env
# It must never go into git.

# --- Database ---------------------------------------------------------------
POSTGRES_DB=NadineCRM
POSTGRES_USER=nadine
# openssl rand -base64 24
POSTGRES_PASSWORD=

# --- How the CRM is opened in a browser -------------------------------------
# Same address as in conf.d/nadine.caddy, with the scheme
PUBLIC_URL=https://crm-nadine.example.com

# --- Sign-in ----------------------------------------------------------------
# openssl rand -base64 48
JWT_KEY=
# How long a sign-in lasts
JWT_EXPIRES_HOURS=72
# The first account, created on startup: Nadine's own
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Nadine

# --- Where Caddy finds the web container ------------------------------------
# Check with: ip -4 addr show docker0
BRIDGE_IP=172.17.0.1
WEB_PORT=8081

# --- Images -----------------------------------------------------------------
TAG=latest
