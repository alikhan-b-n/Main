# Copy to /etc/iconicu/api.env, fill in and lock it down:
#   sudo install -m 600 -o iconicu -g iconicu api.env.example /etc/iconicu/api.env
# Double underscore is the separator for nested configuration keys.

# --- Database ---------------------------------------------------------------
ConnectionStrings__DefaultConnection=Host=127.0.0.1;Database=LamaCRM;Username=iconicu;Password=CHANGE_ME

# Apply pending EF migrations when the service starts
Database__MigrateOnStartup=true

# --- Who may call the API from a browser ------------------------------------
Cors__AllowedOrigins__0=https://crm.example.kz

# --- Sign-in ----------------------------------------------------------------
# Token signing key: 32+ random characters (openssl rand -base64 48)
Auth__Jwt__Key=CHANGE_ME
Auth__Jwt__ExpiresHours=12

# The first administrator; created (or realigned) on every start
Auth__Admin__Email=you@iconicu.kz
Auth__Admin__Password=CHANGE_ME
Auth__Admin__FullName=IconicU Admin

# --- Telegram bot intake ----------------------------------------------------
# Same value as CRM_API_KEY in the bot's environment (openssl rand -base64 32)
Integrations__TelegramBot__ApiKey=CHANGE_ME
