# Copy to deploy/.env next to docker-compose.yml, fill in, then: chmod 600 .env
# docker compose reads this file automatically. It must never go into git.

# --- Where the repositories are checked out ---------------------------------
# Defaults assume three folders side by side, e.g. under /opt/iconicu
API_CONTEXT=../../Main
WEB_CONTEXT=../../lama-crm-redesign
BOT_CONTEXT=../../IconicUTelegramBot

# --- Database ---------------------------------------------------------------
POSTGRES_DB=LamaCRM
POSTGRES_USER=iconicu
POSTGRES_PASSWORD=CHANGE_ME

# --- How the CRM is opened in a browser -------------------------------------
# Domain for the certificate (docker-compose.tls.yml)
DOMAIN=crm.example.kz
ACME_EMAIL=you@iconicu.kz
# Same address with the scheme — the API allows requests only from here
PUBLIC_URL=https://crm.example.kz
# Only for docker-compose.http.yml (checks without a certificate)
HTTP_PORT=80

# --- Sign-in ----------------------------------------------------------------
# openssl rand -base64 48
JWT_KEY=CHANGE_ME
JWT_EXPIRES_HOURS=12
# The first administrator, created on startup
ADMIN_EMAIL=you@iconicu.kz
ADMIN_PASSWORD=CHANGE_ME
ADMIN_NAME=IconicU Admin

# --- Telegram bot -----------------------------------------------------------
BOT_TOKEN=CHANGE_ME
# Shared secret between the bot and the API; openssl rand -base64 32
CRM_API_KEY=CHANGE_ME
# Links used in the bot's final message; leave empty until they exist
BOOKING_URL=
CONSULTATION_URL=
CHANNEL_URL=
# Chat that receives a copy of every lead (optional)
ADMIN_CHAT_ID=

# --- Images -----------------------------------------------------------------
# Tag for iconicu/api, iconicu/web, iconicu/bot
TAG=latest
